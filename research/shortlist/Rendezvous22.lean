def policyTree : Trie := .node (2 * mass positiveTree) (mirror positiveTree) positiveTree

def recorded : Audit :=
  ⟨1178, 4000000056000000196, ⟨17004259653205463428, 3383065596638476, 0⟩⟩

/-- The n-th term is the expected amount of time charged by block n.
Independent resampling and return to the starting gap after failures give
the factor (failure probability)^n. The series must converge. -/
def HasMean (a : Audit) (t : ℝ) : Prop :=
  HasSum (fun n : ℕ =>
    ((a.result.ticks : ℝ) / a.total) * ((a.result.failed : ℝ) / a.total) ^ n) t

theorem renewal (a : Audit) (h : a.result.failed < a.total) :
    HasMean a ((a.result.ticks : ℝ) / (a.total - (a.result.failed : ℝ))) := by
  have hlt : (a.result.failed : ℝ) < a.total := by exact_mod_cast h
  have hm : (0 : ℝ) < a.total := lt_of_le_of_lt (by positivity) hlt
  have hq : (a.result.failed : ℝ) / a.total < 1 := (div_lt_one hm).2 hlt
  have hs := (hasSum_geometric_of_lt_one
    (show (0 : ℝ) ≤ a.result.failed / a.total by positivity) hq).mul_left
      ((a.result.ticks : ℝ) / a.total)
  have h₂ : (a.total : ℝ) - a.result.failed ≠ 0 := by linarith
  have quotient : 1 - (a.result.failed : ℝ) / a.total =
      ((a.total : ℝ) - a.result.failed) / a.total := by
    rw [sub_div, div_self (ne_of_gt hm)]
  have value : (a.result.ticks : ℝ) / (a.total - (a.result.failed : ℝ)) =
      ((a.result.ticks : ℝ) / a.total) * (1 - (a.result.failed : ℝ) / a.total)⁻¹ := by
    rw [quotient, ← div_eq_mul_inv]
    field_simp [ne_of_gt hm, h₂] <;> ring
  unfold HasMean
  rw [value]
  exact hs

theorem recorded_mean :
    HasMean recorded (4251064913301365857 / 999154247600840430 : ℝ) := by
  convert renewal recorded (by decide) using 1 <;> norm_num [recorded]

theorem below_reported_bound :
    (4251064913301365857 / 999154247600840430 : ℝ) < 42574 / 10000 := by
  norm_num

-- Fast replay from the original printable TSV, independent of the expression above.
#eval audit (include_str "rendezvous-22.tsv")

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem policy22_certificate :
    valid 22 0 policyTree = true ∧ leaves positiveTree = recorded.rows ∧
    mass policyTree * mass policyTree = recorded.total ∧
    count 22 0 policyTree policyTree = recorded.result := by decide +kernel

theorem certified_mean :
    ∃ a : Audit, a.rows = leaves positiveTree ∧ a.total = mass policyTree * mass policyTree ∧
      a.result = count 22 0 policyTree policyTree ∧ a.result.wrongGap = 0 ∧
      HasMean a (4251064913301365857 / 999154247600840430 : ℝ) :=
  ⟨recorded, policy22_certificate.2.1.symm, policy22_certificate.2.2.1.symm,
    policy22_certificate.2.2.2.symm, rfl, recorded_mean⟩

#print axioms certified_mean

end Rendezvous22
